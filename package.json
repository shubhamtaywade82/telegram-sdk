{
  "name": "mtproto-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for Telegram's MTProto 2.0 client API: TL schema runtime, transports + auth-key handshake, user login (SMS + 2FA SRP) and bot login, messaging, media, updates - plus a Bot-API-compatible facade.",
  "keywords": [
    "telegram",
    "mtproto",
    "mtproto-sdk",
    "telegram-api",
    "tl-schema",
    "typescript",
    "userbot",
    "bot-api",
    "telegram-sdk"
  ],
  "license": "MIT",
  "author": "shubhamtaywade82",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/telegram-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/telegram-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "codegen": "node scripts/codegen.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:live": "npm run build && MTPROTO_LIVE=1 node --test dist/tests/live.test.js",
    "docs": "typedoc",
    "prepublishOnly": "npm test",
    "extract:rsa": "node scripts/extract-rsa-keys.mjs"
  },
  "peerDependencies": {
    "@nemesis-oss/tg-format": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@nemesis-oss/tg-format": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
